# ============================================
# GCP Configuration
# ============================================
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_PROJECT_NUMBER=your-project-number   # Run: gcloud projects describe $GOOGLE_CLOUD_PROJECT --format="value(projectNumber)"
GOOGLE_CLOUD_LOCATION=global   # Vertex AI model endpoint - "global" gives access to preview models
CLOUD_RUN_REGION=us-central1   # Cloud Run + Agent Runtime region - must be a real GCP region (not global)
GCS_IMAGES_BUCKET=your-project-id-campaign-images   # GCS bucket for generated images
SIGNING_SERVICE_ACCOUNT=   # Optional: SA email for signed image URLs when running locally with user ADC
                           # e.g. your-sa@your-project-id.iam.gserviceaccount.com
                           # Requires roles/iam.serviceAccountTokenCreator on your account


# ============================================
# Vertex AI / Gemini Configuration
# ============================================
GOOGLE_GENAI_USE_VERTEXAI=1
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1   # Default Gemini model for native image generation
GEMINI_IMAGE_BACKUP_MODEL=gemini-3.1-flash-lite-image  # Backup model on quota/rate limit exhaustion

# ============================================
# Image Generation Queue / Rate Limit / Failover (Designer)
# ============================================
IMAGE_GEN_REGIONS=global   # Vertex AI endpoint region ("global" for Agent Platform models)
GCP_TASKS_LOCATION=us-central1   # Cloud Tasks queue location
IMAGE_GEN_TASKS_QUEUE=image-generation   # Cloud Tasks queue name for image-generation jobs
IMAGE_GEN_TASKS_INVOKER_SA=   # Auto-populated by deploy script: SA email Cloud Tasks uses to invoke the internal handler
IMAGE_GEN_TASK_HANDLER_URL=   # Auto-populated by deploy script: full URL of the /internal/tasks/generate-image endpoint
IMAGE_GEN_RATE_LIMIT_CAPACITY=3   # Max image-generation requests per user per window
IMAGE_GEN_RATE_LIMIT_WINDOW_SECONDS=60   # Refill window in seconds for the per-user rate limit
IMAGE_GEN_JOB_POLL_INTERVAL_SECONDS=1   # How often generate_image polls the Firestore job document
IMAGE_GEN_JOB_TIMEOUT_SECONDS=170   # Max time generate_image waits for a job to complete before timing out

# ============================================
# Campaign Driver / Cloud Tasks (Step 2 of replace-gradio-with-spa)
# ============================================
CAMPAIGN_TASKS_LOCATION=us-central1   # Cloud Tasks queue location for campaigns
CAMPAIGN_TASKS_QUEUE=campaigns   # Cloud Tasks queue name for campaign dispatch
CAMPAIGN_TASKS_INVOKER_SA=   # Auto-populated by deploy_campaign_driver.py: SA Cloud Tasks uses to invoke /drive
CAMPAIGN_TASK_HANDLER_URL=   # Auto-populated by deploy_campaign_driver.py: full URL of the campaign-driver /drive endpoint
CAMPAIGN_DRIVER_MAX_DRAIN_RETRIES=3   # Mid-stream error retries before campaign-driver gives up on a drive
CAMPAIGN_DRIVER_RETRY_BACKOFF_SECONDS=5   # Backoff between drain retries / session-growth checks

# ============================================
# Broker (Step 3 of replace-gradio-with-spa)
# ============================================
CAMPAIGN_RATE_LIMIT_CAPACITY=3   # Max campaign starts per user per window
CAMPAIGN_RATE_LIMIT_WINDOW_SECONDS=3600   # Refill window in seconds for the per-user campaign rate limit
CAMPAIGN_MAX_CONCURRENT_DEFAULT=1   # Default per-user concurrent-campaign allowance (override per-user via Firestore campaign_allowances/{uid}.max_concurrent)
CAMPAIGN_ANONYMOUS_MAX_TRIGGERS=3   # Hard, non-refilling lifetime cap on campaign starts+resumes per Firebase Anonymous Auth uid
CAMPAIGN_STALL_THRESHOLD_SECONDS=600   # No new events for this long (while running) -> reported as "stalled" instead of "running"
BROKER_ALLOWED_ORIGINS=https://your-project-id.web.app,http://localhost:5173   # Comma-separated CORS allowlist; the SPA calls the broker's Cloud Run URL directly (no Firebase Hosting rewrite)

# ============================================
# Observability (OpenTelemetry)
# ============================================
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=true

# ============================================
# Agent URLs (Auto-populated by deployment script)
# ============================================
COPYWRITER_AGENT_URL=
CRITIC_AGENT_URL=
DESIGNER_AGENT_URL=
PM_AGENT_URL=
STRATEGIST_AGENT_URL=

# ============================================
# Agent Runtime Configuration (Auto-populated)
# ============================================
AGENT_ENGINE_ID=
AGENT_ENGINE_RESOURCE_NAME=

# ============================================
# Optional: Notion Integration (Project Manager)
# ============================================
NOTION_TOKEN=
NOTION_PROJECT_DATABASE_ID=
NOTION_TASKS_DATABASE_ID=
