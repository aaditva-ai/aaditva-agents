# Firebase Web SDK config -- these are public client identifiers, not
# secrets (see https://firebase.google.com/docs/projects/api-keys), but
# still one Firebase project's worth of config, hence not hardcoded so the
# same build can target dev/staging/prod projects.
# Get these from Firebase Console -> Project settings -> General -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=

# The broker's Cloud Run URL (or Firebase Hosting rewrite target).
VITE_BROKER_URL=https://broker-xxxxx-uc.a.run.app
