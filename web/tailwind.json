{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": true,
  "tsx": true,
  "css": false,
  "tailwind": {
    "config": "tailwind.config.mjs",
    "css": "src/index.css",
    "color": true,
    "cssPath": "src/index.css",
    "headContent": '      <link rel="preconnect" href="https://fonts.googleapis.com">\n      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>\n      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">',
    "classes": {
